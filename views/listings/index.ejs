<% layout("/layouts/boilerplate") %>

<div class="container py-4">
    <!-- Category Filter Bar -->
    <div class="category-filter-wrapper mb-4">
        <div class="category-scroll-container">
            <% const categories = [
                { name: "All", icon: "fa-solid fa-border-all" },
                { name: "Trending", icon: "fa-solid fa-fire" },
                { name: "Rooms", icon: "fa-solid fa-bed" },
                { name: "Iconic Cities", icon: "fa-solid fa-city" },
                { name: "Mountains", icon: "fa-solid fa-mountain" },
                { name: "Castles", icon: "fa-solid fa-chess-rook" },
                { name: "Amazing Pools", icon: "fa-solid fa-person-swimming" },
                { name: "Camping", icon: "fa-solid fa-campground" },
                { name: "Farms", icon: "fa-solid fa-cow" },
                { name: "Arctic", icon: "fa-solid fa-snowflake" },
                { name: "Beachfront", icon: "fa-solid fa-umbrella-beach" },
                { name: "Luxury", icon: "fa-solid fa-crown" }
            ]; %>

            <% for(let cat of categories) { %>
                <a 
                    href="/listings<%= cat.name === 'All' ? '' : '?category=' + encodeURIComponent(cat.name) %>" 
                    class="category-card text-decoration-none <%= (typeof selectedCategory !== 'undefined' && selectedCategory === cat.name) || (cat.name === 'All' && (!selectedCategory || selectedCategory === 'All')) ? 'active' : '' %>"
                >
                    <div class="category-icon-wrapper">
                        <i class="<%= cat.icon %>"></i>
                    </div>
                    <span class="category-name"><%= cat.name %></span>
                </a>
            <% } %>
        </div>
    </div>

    <!-- Controls Bar: Results Count & Tax Toggle -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 p-3 bg-white rounded-4 border shadow-xs">
        <div>
            <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-bold fs-5 text-dark">Results for "<%= searchQuery %>"</span>
                    <a href="/listings" class="badge bg-secondary text-decoration-none rounded-pill px-2 py-1">
                        Clear <i class="fa-solid fa-xmark ms-1"></i>
                    </a>
                </div>
                <small class="text-muted"><%= allListings.length %> places found</small>
            <% } else { %>
                <h4 class="fw-bold mb-0 text-dark">
                    <%= typeof selectedCategory !== 'undefined' && selectedCategory !== 'All' ? selectedCategory : 'All' %> Stays
                </h4>
                <small class="text-muted">Explore <%= allListings.length %> extraordinary destinations</small>
            <% } %>
        </div>

        <!-- Tax Toggle Switch -->
        <div class="tax-toggle-box d-flex align-items-center gap-3 mt-3 mt-sm-0 p-2 px-3 rounded-pill bg-light border">
            <div class="form-check form-switch m-0 d-flex align-items-center gap-2">
                <input class="form-check-input cursor-pointer" type="checkbox" role="switch" id="taxSwitch" />
                <label class="form-check-label fw-medium small text-dark cursor-pointer mb-0" for="taxSwitch">
                    Display total after taxes (+18% GST)
                </label>
            </div>
        </div>
    </div>

    <!-- Listings Grid -->
    <% if (allListings.length === 0) { %>
        <div class="empty-state text-center py-5 my-4 bg-white rounded-4 border">
            <div class="icon-circle bg-primary-soft text-primary mx-auto mb-3" style="width: 70px; height: 70px;">
                <i class="fa-solid fa-compass fa-2xl"></i>
            </div>
            <h3 class="fw-bold text-dark">No stays found</h3>
            <p class="text-muted mx-auto mb-4" style="max-width: 450px;">
                We couldn't find any listings matching your search criteria. Try adjusting your search term or exploring a different category.
            </p>
            <a href="/listings" class="btn btn-primary rounded-pill px-4 py-2">
                View All Listings
            </a>
        </div>
    <% } else { %>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            <% for(let listing of allListings) { %>
                <div class="col">
                    <div class="card h-100 listing-card border-0 shadow-sm rounded-4 overflow-hidden position-relative">
                        <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark d-block">
                            <div class="img-wrapper position-relative overflow-hidden">
                                <img 
                                    src="<%= listing.image?.url || 'https://images.unsplash.com/photo-1552733407-5d5c46c3bb3b?w=800' %>" 
                                    class="card-img-top listing-img" 
                                    alt="<%= listing.title %>"
                                    loading="lazy"
                                />
                                <span class="badge bg-dark-glass position-absolute top-0 start-0 m-3 px-3 py-2 rounded-pill">
                                    <%= listing.category || 'Trending' %>
                                </span>
                            </div>
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <h5 class="card-title fw-bold text-truncate mb-0" style="max-width: 80%;"><%= listing.title %></h5>
                                    <div class="rating-badge small fw-bold">
                                        <i class="fa-solid fa-star text-warning"></i> 4.9
                                    </div>
                                </div>
                                <p class="text-muted small mb-2 text-truncate">
                                    <i class="fa-solid fa-location-dot me-1 text-secondary"></i><%= listing.location %>, <%= listing.country %>
                                </p>
                                <div class="d-flex justify-content-between align-items-baseline mt-2 pt-2 border-top">
                                    <div>
                                        <span class="fw-bold text-dark fs-5 price-base">&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : 0 %></span>
                                        <span class="fw-bold text-dark fs-5 price-taxed d-none" data-price="<%= listing.price || 0 %>">
                                            &#8377; <%= listing.price ? Math.round(listing.price * 1.18).toLocaleString("en-IN") : 0 %>
                                        </span>
                                        <span class="text-muted small"> / night</span>
                                        <span class="badge bg-light text-muted tax-badge d-none small">incl. taxes</span>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            <% } %>
        </div>
    <% } %>
</div>
