<% layout("/layouts/boilerplate") %>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Form Card -->
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <div class="mb-4">
                    <span class="badge bg-primary-soft text-primary px-3 py-2 rounded-pill fw-semibold mb-2">Edit Listing</span>
                    <h2 class="fw-bold text-dark mb-1">Update Your Property</h2>
                    <p class="text-muted">Keep your pricing, description, and photos up to date</p>
                </div>

                <form action="/listings/<%= listing._id %>?_method=PUT" method="POST" class="needs-validation" novalidate id="editListingForm">
                    <!-- Title -->
                    <div class="mb-3">
                        <label for="title" class="form-label fw-semibold">Listing Title</label>
                        <input 
                            type="text" 
                            name="listing[title]" 
                            id="title" 
                            value="<%= listing.title %>"
                            class="form-control form-control-lg rounded-3 fs-6" 
                            required 
                        />
                        <div class="valid-feedback">Looks good!</div>
                        <div class="invalid-feedback">Please enter a valid title.</div>
                    </div>

                    <!-- Category & Price Row -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="category" class="form-label fw-semibold">Property Category</label>
                            <select name="listing[category]" id="category" class="form-select rounded-3">
                                <% const categories = ["Trending", "Beachfront", "Mountains", "Iconic Cities", "Castles", "Amazing Pools", "Camping", "Farms", "Arctic", "Luxury", "Rooms"]; %>
                                <% for(let cat of categories) { %>
                                    <option value="<%= cat %>" <%= listing.category === cat ? 'selected' : '' %>><%= cat %></option>
                                <% } %>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="price" class="form-label fw-semibold">Price per Night (&#8377; INR)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">&#8377;</span>
                                <input 
                                    type="number" 
                                    name="listing[price]" 
                                    id="price" 
                                    value="<%= listing.price %>"
                                    class="form-control rounded-end-3" 
                                    min="0" 
                                    required 
                                />
                                <div class="invalid-feedback">Please enter a valid price.</div>
                            </div>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label for="description" class="form-label fw-semibold">Description</label>
                        <textarea 
                            name="listing[description]" 
                            id="description" 
                            rows="4" 
                            class="form-control rounded-3" 
                            required
                        ><%= listing.description %></textarea>
                        <div class="invalid-feedback">Please enter a description.</div>
                    </div>

                    <!-- Image URL with Live Preview -->
                    <div class="mb-4">
                        <label for="imageUrl" class="form-label fw-semibold">Image URL</label>
                        <input 
                            type="url" 
                            name="listing[image][url]" 
                            id="imageUrl" 
                            value="<%= listing.image?.url || '' %>"
                            class="form-control rounded-3" 
                        />
                        <div class="form-text text-muted small">Update with a direct image URL.</div>
                        
                        <!-- Live Preview Box -->
                        <div class="mt-3 p-2 bg-light border rounded-3 text-center" id="imagePreviewContainer">
                            <small class="text-muted d-block mb-2 fw-semibold">Current Image Preview:</small>
                            <img 
                                id="imagePreview" 
                                src="<%= listing.image?.url || 'https://images.unsplash.com/photo-1552733407-5d5c46c3bb3b?w=800' %>" 
                                alt="Listing preview" 
                                class="rounded-3 shadow-xs" 
                                style="max-height: 220px; width: 100%; object-fit: cover;" 
                            />
                        </div>
                    </div>

                    <!-- Location & Country Row -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label for="location" class="form-label fw-semibold">City / Location</label>
                            <input 
                                type="text" 
                                name="listing[location]" 
                                id="location" 
                                value="<%= listing.location %>"
                                class="form-control rounded-3" 
                                required 
                            />
                            <div class="invalid-feedback">Please provide a location.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="country" class="form-label fw-semibold">Country</label>
                            <input 
                                type="text" 
                                name="listing[country]" 
                                id="country" 
                                value="<%= listing.country %>"
                                class="form-control rounded-3" 
                                required 
                            />
                            <div class="invalid-feedback">Please provide a country.</div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex align-items-center gap-3 pt-3 border-top">
                        <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold">
                            <i class="fa-solid fa-check me-2"></i> Save Changes
                        </button>
                        <a href="/listings/<%= listing._id %>" class="btn btn-outline-secondary rounded-pill px-4 py-2">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
