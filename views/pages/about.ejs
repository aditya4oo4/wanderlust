<% layout("/layouts/boilerplate") %>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- Hero Section -->
            <div class="text-center mb-5">
                <span class="badge bg-primary-soft text-primary px-3 py-2 rounded-pill fw-semibold mb-2">About Wanderlust</span>
                <h1 class="display-4 fw-bold text-dark">Connecting Travelers With Extraordinary Places</h1>
                <p class="lead text-muted mx-auto" style="max-width: 700px;">
                    We believe that travel is more than just booking a room—it's about collecting unforgettable experiences, finding solace in nature, and exploring vibrant cultures.
                </p>
            </div>

            <!-- Story Cards -->
            <div class="row g-4 mb-5">
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center">
                        <div class="icon-circle bg-primary-soft text-primary mx-auto mb-3">
                            <i class="fa-solid fa-gem fa-xl"></i>
                        </div>
                        <h4 class="fw-bold">Curated Stays</h4>
                        <p class="text-muted">Every listing on Wanderlust is handpicked and verified to ensure high standards of comfort, aesthetic beauty, and authenticity.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center">
                        <div class="icon-circle bg-primary-soft text-primary mx-auto mb-3">
                            <i class="fa-solid fa-shield-halved fa-xl"></i>
                        </div>
                        <h4 class="fw-bold">Trust & Safety</h4>
                        <p class="text-muted">With secure transactions, verified reviews from real travelers, and 24/7 dedicated support, you can travel with complete peace of mind.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center">
                        <div class="icon-circle bg-primary-soft text-primary mx-auto mb-3">
                            <i class="fa-solid fa-earth-americas fa-xl"></i>
                        </div>
                        <h4 class="fw-bold">Global Community</h4>
                        <p class="text-muted">We empower homeowners and passionate hosts worldwide to share their spaces and connect meaningfully with global adventurers.</p>
                    </div>
                </div>
            </div>

            <!-- Mission Banner -->
            <div class="card border-0 rounded-4 p-5 text-white mb-5" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <h2 class="fw-bold mb-3">Ready to share your extraordinary space?</h2>
                        <p class="text-white-50 mb-0">Join thousands of hosts earning income on Wanderlust while welcoming travelers from across the globe.</p>
                    </div>
                    <div class="col-md-4 text-md-end mt-4 mt-md-0">
                        <a href="/listings/new" class="btn btn-primary btn-lg rounded-pill px-4">Start Hosting</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
