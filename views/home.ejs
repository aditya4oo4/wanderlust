<% layout("/layouts/boilerplate") %>

<!-- Hero Section -->
<section class="hero-section text-white position-relative d-flex align-items-center mb-5">
    <div class="hero-overlay"></div>
    <div class="container position-relative z-index-2 py-5">
        <div class="row align-items-center min-vh-50 py-5">
            <div class="col-lg-8 text-start">
                <span class="badge bg-primary-soft text-white border border-white-50 px-3 py-2 rounded-pill fw-semibold mb-3">
                    <i class="fa-solid fa-compass me-1 text-primary"></i> Explore The World With Wanderlust
                </span>
                <h1 class="display-3 fw-bold mb-3 tracking-tight">
                    Find Your Next <br class="d-none d-md-block" />
                    <span class="text-gradient">Extraordinary Stay</span>
                </h1>
                <p class="lead mb-4 text-white-75 max-w-600">
                    Discover handpicked luxury villas, cozy mountain retreats, beachfront cottages, and iconic city lofts around the world.
                </p>

                <!-- Search Bar Card -->
                <div class="hero-search-card bg-white p-3 rounded-4 shadow-lg text-dark">
                    <form action="/listings" method="GET" class="row g-2 align-items-center">
                        <div class="col-md-5">
                            <div class="form-floating">
                                <input type="text" name="search" class="form-control border-0" id="heroSearchLocation" placeholder="Where to?" />
                                <label for="heroSearchLocation"><i class="fa-solid fa-location-dot text-primary me-2"></i>Destination / City</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-floating">
                                <select name="category" class="form-select border-0" id="heroSearchCategory">
                                    <option value="All">All Categories</option>
                                    <option value="Trending">Trending</option>
                                    <option value="Beachfront">Beachfront</option>
                                    <option value="Mountains">Mountains</option>
                                    <option value="Iconic Cities">Iconic Cities</option>
                                    <option value="Castles">Castles</option>
                                    <option value="Amazing Pools">Amazing Pools</option>
                                    <option value="Camping">Camping</option>
                                    <option value="Luxury">Luxury</option>
                                </select>
                                <label for="heroSearchCategory"><i class="fa-solid fa-layer-group text-primary me-2"></i>Experience</label>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-primary w-100 py-3 rounded-3 fw-semibold shadow-sm">
                                <i class="fa-solid fa-magnifying-glass me-2"></i> Search
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Categories Grid Bar -->
<section class="container mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Explore By Category</h3>
            <p class="text-muted mb-0">Curated experiences tailored to your travel vibe</p>
        </div>
        <a href="/listings" class="btn btn-outline-dark btn-sm rounded-pill px-3">View All</a>
    </div>

    <div class="category-scroll-container pb-2">
        <a href="/listings?category=Trending" class="category-card text-decoration-none">
            <div class="category-icon-wrapper"><i class="fa-solid fa-fire"></i></div>
            <span class="category-name">Trending</span>
        </a>
        <a href="/listings?category=Beachfront" class="category-card text-decoration-none">
            <div class="category-icon-wrapper"><i class="fa-solid fa-umbrella-beach"></i></div>
            <span class="category-name">Beachfront</span>
        </a>
        <a href="/listings?category=Mountains" class="category-card text-decoration-none">
            <div class="category-icon-wrapper"><i class="fa-solid fa-mountain"></i></div>
            <span class="category-name">Mountains</span>
        </a>
        <a href="/listings?category=Iconic Cities" class="category-card text-decoration-none">
            <div class="category-icon-wrapper"><i class="fa-solid fa-city"></i></div>
            <span class="category-name">Iconic Cities</span>
        </a>
        <a href="/listings?category=Castles" class="category-card text-decoration-none">
            <div class="category-icon-wrapper"><i class="fa-solid fa-chess-rook"></i></div>
            <span class="category-name">Castles</span>
        </a>
        <a href="/listings?category=Amazing Pools" class="category-card text-decoration-none">
            <div class="category-icon-wrapper"><i class="fa-solid fa-person-swimming"></i></div>
            <span class="category-name">Amazing Pools</span>
        </a>
        <a href="/listings?category=Camping" class="category-card text-decoration-none">
            <div class="category-icon-wrapper"><i class="fa-solid fa-campground"></i></div>
            <span class="category-name">Camping</span>
        </a>
        <a href="/listings?category=Farms" class="category-card text-decoration-none">
            <div class="category-icon-wrapper"><i class="fa-solid fa-cow"></i></div>
            <span class="category-name">Farms</span>
        </a>
        <a href="/listings?category=Arctic" class="category-card text-decoration-none">
            <div class="category-icon-wrapper"><i class="fa-solid fa-snowflake"></i></div>
            <span class="category-name">Arctic</span>
        </a>
        <a href="/listings?category=Luxury" class="category-card text-decoration-none">
            <div class="category-icon-wrapper"><i class="fa-solid fa-crown"></i></div>
            <span class="category-name">Luxury</span>
        </a>
    </div>
</section>

<!-- Featured Listings Section -->
<section class="container mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Featured Stays</h3>
            <p class="text-muted mb-0">Handpicked homes highly rated by global travelers</p>
        </div>
        <a href="/listings" class="btn btn-link text-primary text-decoration-none fw-semibold">
            See all <%= featuredListings.length %>+ stays <i class="fa-solid fa-arrow-right ms-1"></i>
        </a>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        <% for(let listing of featuredListings) { %>
            <div class="col">
                <div class="card h-100 listing-card border-0 shadow-sm rounded-4 overflow-hidden position-relative">
                    <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark d-block">
                        <div class="img-wrapper position-relative overflow-hidden">
                            <img 
                                src="<%= listing.image?.url || 'https://images.unsplash.com/photo-1552733407-5d5c46c3bb3b?w=800' %>" 
                                class="card-img-top listing-img" 
                                alt="<%= listing.title %>"
                                loading="lazy"
                            />
                            <span class="badge bg-dark-glass position-absolute top-0 start-0 m-3 px-3 py-2 rounded-pill">
                                <%= listing.category || 'Trending' %>
                            </span>
                        </div>
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <h5 class="card-title fw-bold text-truncate mb-0" style="max-width: 80%;"><%= listing.title %></h5>
                                <div class="rating-badge small fw-bold">
                                    <i class="fa-solid fa-star text-warning"></i> 4.9
                                </div>
                            </div>
                            <p class="text-muted small mb-2 text-truncate">
                                <i class="fa-solid fa-location-dot me-1 text-secondary"></i><%= listing.location %>, <%= listing.country %>
                            </p>
                            <div class="d-flex justify-content-between align-items-baseline mt-2 pt-2 border-top">
                                <div>
                                    <span class="fw-bold text-dark fs-5">&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : 0 %></span>
                                    <span class="text-muted small"> / night</span>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            </div>
        <% } %>
    </div>
</section>

<!-- Why Wanderlust / Value Props -->
<section class="container my-5 py-4">
    <div class="text-center mb-5">
        <span class="badge bg-primary-soft text-primary px-3 py-2 rounded-pill fw-semibold mb-2">The Wanderlust Promise</span>
        <h2 class="display-6 fw-bold">Why Travel With Us</h2>
        <p class="text-muted mx-auto" style="max-width: 600px;">We take the hassle out of vacation planning with premium quality, transparent pricing, and trusted hosts.</p>
    </div>

    <div class="row g-4">
        <div class="col-md-3 col-sm-6">
            <div class="feature-box text-center p-4 rounded-4 h-100 bg-light-subtle border">
                <div class="icon-circle bg-primary-soft text-primary mx-auto mb-3">
                    <i class="fa-solid fa-shield-heart fa-xl"></i>
                </div>
                <h5 class="fw-bold">Verified Places</h5>
                <p class="text-muted small mb-0">Every home is verified for quality, accurate photos, amenities, and cleanliness.</p>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="feature-box text-center p-4 rounded-4 h-100 bg-light-subtle border">
                <div class="icon-circle bg-primary-soft text-primary mx-auto mb-3">
                    <i class="fa-solid fa-tag fa-xl"></i>
                </div>
                <h5 class="fw-bold">Best Price Guarantee</h5>
                <p class="text-muted small mb-0">No hidden booking markups. Enjoy clear pricing and real-time currency conversion.</p>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="feature-box text-center p-4 rounded-4 h-100 bg-light-subtle border">
                <div class="icon-circle bg-primary-soft text-primary mx-auto mb-3">
                    <i class="fa-solid fa-headset fa-xl"></i>
                </div>
                <h5 class="fw-bold">24/7 Dedicated Support</h5>
                <p class="text-muted small mb-0">Our global concierge team is ready to assist you day and night throughout your journey.</p>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="feature-box text-center p-4 rounded-4 h-100 bg-light-subtle border">
                <div class="icon-circle bg-primary-soft text-primary mx-auto mb-3">
                    <i class="fa-solid fa-star-half-stroke fa-xl"></i>
                </div>
                <h5 class="fw-bold">Real Guest Reviews</h5>
                <p class="text-muted small mb-0">Honest feedback and ratings submitted by travelers who have stayed at each property.</p>
            </div>
        </div>
    </div>
</section>

<!-- Host Call to Action Banner -->
<section class="container my-5">
    <div class="host-banner p-5 rounded-4 text-white position-relative overflow-hidden shadow-lg">
        <div class="row align-items-center position-relative z-index-2">
            <div class="col-lg-7">
                <span class="badge bg-white text-dark px-3 py-2 rounded-pill fw-bold mb-3">Wanderlust Host</span>
                <h2 class="display-5 fw-bold mb-3">Turn Your Space Into A Dream Destination</h2>
                <p class="lead text-white-75 mb-4">
                    Join millions of hosts on Wanderlust. List your home, boutique room, or unique getaway and connect with respectful travelers.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a href="/listings/new" class="btn btn-primary btn-lg rounded-pill px-4 shadow">
                        <i class="fa-solid fa-plus me-2"></i> List Your Home
                    </a>
                    <a href="/about" class="btn btn-outline-light btn-lg rounded-pill px-4">
                        Learn More
                    </a>
                </div>
            </div>
            <div class="col-lg-5 d-none d-lg-block text-center">
                <div class="host-badge-card bg-white text-dark p-4 rounded-4 shadow-sm d-inline-block text-start">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="avatar-circle bg-primary text-white fw-bold">W</div>
                        <div>
                            <h6 class="fw-bold mb-0">Top Superhost</h6>
                            <small class="text-muted">Earn up to &#8377;85,000 / mo</small>
                        </div>
                    </div>
                    <p class="small text-muted mb-0">"Listing my villa on Wanderlust gave me financial freedom and introduced me to wonderful guests from around the globe."</p>
                </div>
            </div>
        </div>
    </div>
</section>
